# --- MQTT ---
MQTT_HOST=localhost
MQTT_PORT=1883
# --- NASA FIRMS (https://firms.modaps.eosdis.nasa.gov/api/map_key/) ---
FIRMS_MAP_KEY=
FIRMS_BBOX=-63.0,-20.0,-58.0,-15.0
FIRMS_REFRESH_SECONDS=600
# --- Base de datos: si TURSO_* esta vacio se usa SQLite local (plan B) ---
DB_PATH=sat_fire.db
TURSO_URL=
TURSO_TOKEN=
# --- Telegram (BotFather). CHAT_IDS separados por coma ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
# --- Seguridad demo: si se define, POST confirm/false-alarm/demo exigen header X-Demo-Token ---
DEMO_TOKEN=
DEMO_MODE=true
# --- Reglas ---
HOTSPOT_RADIUS_KM=10
ALERT_COOLDOWN_SECONDS=120
STALE_AFTER_SECONDS=60
# --- Hora 1: devolver el JSON canonico fijo para que Android avance ---
MOCK_MODE=false
